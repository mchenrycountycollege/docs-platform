<!DOCTYPE HTML>
<html class="no-js" dir="ltr" lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta content="ie=edge" http-equiv="x-ua-compatible"/>
        <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
        <system-page-meta-keywords/>
        <system-page-meta-description/>
        <system-region name="METADATA"/>
        <system-region name="HEAD FILES"/>
        <link href="https://catalog.mchenry.edu/widget-api/widget-api.min.css" rel="stylesheet"/>
        <system-region name="GOOGLE SEARCH"/>
        <system-region name="GOOGLE TAG MANAGER HEAD"/>
    </head>
    <body>
        <system-region name="GOOGLE TAG MANAGER BODY"/>
        <div class="wrapper-main">
            <system-region name="EMERGENCY ALERTS"/>
            <system-region name="TOP NAVIGATION"/>
            <div class="relative-position">
                <a class="exit-off-canvas" href="#">
                    <span class="sr-only">close</span>
                </a>
                <system-region name="SOCIAL MEDIA BAR"/>
                <section class="relative-position">
                    <div class="row inner-mid-main admissions-wrapper">
                        <system-region name="BREADCRUMBS"/>
                        <system-region name="SIDEBAR"/>
                        <system-region name="DEFAULT"/>
                    </div>
                </section>
                <system-region name="BOTTOM"/>
                <system-region name="FOOTER"/>
            </div>
        </div>
